# Public site configuration
NEXT_PUBLIC_SITE_URL=https://arinzelab.vercel.app

# Existing contact form
RESEND_API_KEY=

# Telegram Bot API. Keep all values server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_SESSION_SECRET=replace-with-a-different-long-random-secret
TELEGRAM_ADMIN_USER_IDS=
# Singular form is also accepted for a one-admin deployment.
TELEGRAM_ADMIN_USER_ID=
# Optional: restrict administration to specific chat IDs.
TELEGRAM_ADMIN_CHAT_IDS=

# GitHub Contents API. Restrict the token to this repository.
GITHUB_TOKEN=
GITHUB_OWNER=arinze116
GITHUB_REPO=arinze-lab
GITHUB_BRANCH=main

# Optional durable session and webhook idempotency storage for Vercel.
# Without these values, local development uses process memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
